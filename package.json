{
  "name": "ts-monorepo-template",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/oxlint/repo"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "setup": "bun install && bun run --cwd packages/ui playwright install chromium && bun packages/dev/src/cli.ts setup && bun packages/dev/src/cli.ts doctor",
    "doctor": "bun packages/dev/src/cli.ts doctor",
    "up": "bun packages/dev/src/cli.ts up",
    "down": "bun packages/dev/src/cli.ts down",
    "status": "bun packages/dev/src/cli.ts status",
    "logs": "bun packages/dev/src/cli.ts logs"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.91.0",
    "@types/bun": "^1.4.4",
    "knip": "^6.42.1",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  },
  "packageManager": "bun@1.4.4"
}
