{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun run format)",
      "Bash(bun run format:check)",
      "Bash(bun run lint *)",
      "Bash(bun run typecheck *)",
      "Bash(bun run test *)",
      "Bash(bun run build *)",
      "Bash(bun run knip *)",
      "Bash(bun run doctor *)",
      "Bash(bun run up *)",
      "Bash(bun run down *)",
      "Bash(bun run status *)",
      "Bash(bun run logs *)",
      "Bash(bun test *)",
      "Bash(bunx turbo run *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": ["Bash(git diff *--output*)", "Bash(git log *--output*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bun -e 'try { const file = JSON.parse(await Bun.stdin.text())?.tool_input?.file_path; if (typeof file === \"string\") Bun.spawnSync([\"bun\", \"fmt\", file], { stdout: \"ignore\", stderr: \"ignore\" }); } catch {}'"
          }
        ]
      }
    ]
  }
}
