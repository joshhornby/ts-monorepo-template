{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // Browser code must not reach for Bun. Server-only code in a web app
    // reads process.env through vite's types.
    "types": ["vite/client"]
  }
}
