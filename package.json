{
  "name": "ts-monorepo-template",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "knip": "knip",
    "setup": "bun install && bun packages/dev/src/cli.ts setup && bun packages/dev/src/cli.ts doctor",
    "doctor": "bun packages/dev/src/cli.ts doctor",
    "up": "bun packages/dev/src/cli.ts up",
    "down": "bun packages/dev/src/cli.ts down",
    "status": "bun packages/dev/src/cli.ts status",
    "logs": "bun packages/dev/src/cli.ts logs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@oxlint/plugins": "1.78.0",
    "@types/bun": "^1.4.4",
    "eslint": "^10.13.0",
    "knip": "^6.42.1",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "type": "module"
}
